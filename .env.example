# Copy to .env and fill. Loaded by the operator before running the pipeline.
# Proxy (github.com + LLM APIs need it in CN network)
HTTPS_PROXY=http://127.0.0.1:7897
# Review panel
GEMINI_API_KEY=          # from violoop secrets
# Claude via AWS Bedrock
AWS_BEARER_TOKEN_BEDROCK= # from violoop secrets
BEDROCK_REGION=ap-southeast-1
BEDROCK_CLAUDE_MODEL_ID=global.anthropic.claude-opus-4-8
CLAUDE_MAX_TOKENS=4096
# Store backend (MR-1 #37). 留空 => SQLite 默认(board/competitor_eval.db)。
# 填自托管 Postgres 连接串 => store 层自动切 PG(需 `pip install pg8000`,纯 Python)。
# 评测数据不出本地: 只连自托管/本地 PG, 不用 Supabase/Neon 等托管云库(ADR-0018)。
# DATABASE_URL=postgresql://eval:secret@127.0.0.1:5432/competitor_eval
